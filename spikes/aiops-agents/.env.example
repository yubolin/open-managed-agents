# OMA main-node base URL (public REST boundary)
OMA_BASE=http://localhost:8787
# x-api-key accepted by main-node's authMw (any value when AUTH_DISABLED=1)
OMA_API_KEY=test-key
# Environment id sessions bind to (required for cloud agents; e.g. the
# Feishu Echo PoC env). Find one: Console → Environments, or omit for
# local-runtime agents.
OMA_ENVIRONMENT_ID=

# Agent names — must match scripts/seed-aiops-digital-employees.ts
SUPERVISOR_NAME=aiops-duty-supervisor
EXPERT_SRE_NAME=aiops-expert-sre
EXPERT_NETWORK_NAME=aiops-expert-network
EXPERT_DB_NAME=aiops-expert-db
EXPERT_SECURITY_NAME=aiops-expert-security

# Orchestration tuning
SUPERVISOR_MAX_TURNS=3
TURN_TIMEOUT_MS=180000
WATCH_POLL_MS=5000
