# Feishu self-built app — create at https://open.feishu.cn/app
# Required scopes (PoC): im:message, im:message:send_as_bot, im:chat (read chat meta)
# Enable "长连接" (WebSocket / Long Connection) mode in the app event config.
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OMA runtime — main-node running locally with a configured agent + model creds.
OMA_BASE_URL=http://127.0.0.1:8787
OMA_API_KEY=oma_xxxxxxxxxxxxxxxx
# A session that belongs to the API key's tenant. Create once in the OMA console.
OMA_SESSION_ID=ses_xxxxxxxxxxxxxxxx

# Bridge mode:
#   oma  — forward to OMA runtime (POST /v1/sessions/:id/messages, real model)
#   echo — local echo; OMA_* not required and not validated at startup
MODE=oma

LOG_LEVEL=info
